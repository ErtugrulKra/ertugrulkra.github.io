---
interface MediumPost {
  title: string;
  link: string;
  pubDate: string;
  contentSnippet: string;
  categories: string[];
  guid: string;
  author: string;
}

interface Props {
  post: MediumPost;
  lang: string;
}

const { post, lang } = Astro.props;

const date = new Date(post.pubDate);
---

<article
  class="border-2 border-gray-200 rounded-lg p-5 hover:shadow-xl transition-all bg-white shadow-sm hover:border-blue-500 hover:scale-105 transform"
  data-post-card
  data-url={post.link}
  data-title={post.title}
  data-description={post.contentSnippet || ''}
  data-type="external"
>
  <div class="flex items-center gap-2 mb-2">
    <span class="px-2 py-1 bg-blue-600 text-white rounded text-xs font-semibold shadow-sm">
      Medium
    </span>
  </div>
  
  <h2 class="text-xl font-bold mb-2">
    <a href={post.link} target="_blank" rel="noopener noreferrer" class="text-gray-800 hover:text-blue-600 transition-colors">
      {post.title}
    </a>
  </h2>
  
  {post.contentSnippet && <p class="text-gray-600 mb-4">{post.contentSnippet}</p>}
  
  <div class="flex flex-wrap gap-2 mb-4">
    {post.categories.map((tag: string) => (
      <span
        class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-sm font-medium"
      >
        {tag}
      </span>
    ))}
  </div>
  
  <div class="flex items-center justify-between text-sm text-gray-500">
    <time datetime={date.toISOString()}>
      {date.toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
    <a href={post.link} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1 font-medium">
      {lang === 'en' ? 'Read on Medium →' : 'Medium\'da Oku →'}
    </a>
  </div>
</article>

