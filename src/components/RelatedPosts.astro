---
import PostList from './PostList.astro';
import { t, type Lang } from '../lib/i18n';
import type { CombinedPost } from '../lib/posts';

interface Props {
  lang: Lang;
  posts: CombinedPost[];
}

const { lang, posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-700">
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-slate-100">{t(lang, 'relatedPosts')}</h2>
    <PostList posts={posts} lang={lang} />
  </section>
)}
