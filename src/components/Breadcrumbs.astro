---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-500 dark:text-slate-400">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href && index < items.length - 1 ? (
          <a href={item.href} class="hover:text-blue-600 dark:hover:text-blue-400">{item.name}</a>
        ) : (
          <span class="text-gray-800 dark:text-slate-200" aria-current={index === items.length - 1 ? 'page' : undefined}>
            {item.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
