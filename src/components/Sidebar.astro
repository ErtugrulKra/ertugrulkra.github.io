---
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { isAboutPath, isBlogPath, isHomePath, localePath, t, type Lang } from '../lib/i18n';

interface Props {
  currentPath?: string;
  lang?: Lang;
}

const { currentPath = '/', lang = 'en' } = Astro.props as { currentPath?: string; lang?: Lang };

const homeHref = localePath(lang, '/');
const aboutHref = localePath(lang, '/about');
const blogHref = localePath(lang, '/blog');
const searchHref = localePath(lang, '/search');

const nav = [
  {
    href: homeHref,
    label: t(lang, 'home'),
    current: isHomePath(currentPath, lang),
    icon: 'home',
  },
  {
    href: aboutHref,
    label: t(lang, 'about'),
    current: isAboutPath(currentPath, lang),
    icon: 'about',
  },
  {
    href: blogHref,
    label: t(lang, 'blog'),
    current: isBlogPath(currentPath, lang),
    icon: 'blog',
  },
  {
    href: searchHref,
    label: t(lang, 'search'),
    current: currentPath === searchHref,
    icon: 'search',
  },
];
---

<aside class="lg:fixed lg:left-0 lg:top-0 lg:h-screen lg:w-80 bg-gradient-to-b from-blue-600 to-blue-700 text-slate-100 z-40">
  <div class="hidden lg:flex lg:flex-col p-8 h-full overflow-y-auto">
    <div class="text-center mb-8">
      <p class="text-3xl font-bold mb-4 uppercase text-white">Ertugrul Kara</p>
      <div class="mb-4">
        <div class="w-32 h-32 mx-auto rounded-full overflow-hidden border-4 border-white/30 shadow-lg">
          <img
            src="/avatar.png"
            alt="Ertugrul Kara"
            width="128"
            height="128"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <p class="text-slate-100 text-sm leading-relaxed">
        {lang === 'en'
          ? "Hello, I'm Ertugrul Kara and I'm a software engineer. Welcome to my blog!"
          : 'Merhaba, ben Ertugrul Kara ve bir yazılım mühendisiyim. Bloguma hoş geldiniz!'}
      </p>
    </div>

    <div class="flex justify-center gap-3 mb-6">
      <a
        href="https://github.com/ertugrulkra"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
        aria-label="GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a
        href="https://www.linkedin.com/in/ertugrul-kra/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
        aria-label="LinkedIn"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a
        href="https://medium.com/@ertugrulkra"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
        aria-label="Medium"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
        </svg>
      </a>
      <a
        href="mailto:hello@ertugrulkara.com"
        class="w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
        aria-label="Email"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>
    </div>

    <div class="flex items-center justify-center gap-2 mb-8">
      <LanguageToggle lang={lang} currentPath={currentPath} />
      <ThemeToggle lang={lang} />
    </div>

    <nav class="mb-8" aria-label="Primary">
      <ul class="space-y-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-3 px-4 py-3 rounded-lg transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-white',
                item.current ? 'bg-white/30 text-white' : 'text-slate-100 hover:bg-white/10',
              ]}
              aria-current={item.current ? 'page' : undefined}
            >
              {item.icon === 'home' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
              )}
              {item.icon === 'about' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              )}
              {item.icon === 'blog' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              )}
              {item.icon === 'search' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/>
                </svg>
              )}
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="lg:hidden sticky top-0 z-50 bg-gradient-to-b from-blue-600 to-blue-700 shadow-lg">
    <div class="px-3 py-2">
      <div class="flex flex-col items-center gap-1.5">
        <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-white/30">
          <img src="/avatar.png" alt="Ertugrul Kara" width="40" height="40" class="w-full h-full object-cover" />
        </div>
        <p class="text-xs font-bold uppercase text-white leading-tight">Ertugrul Kara</p>
        <div class="flex items-center gap-2 mt-1">
          <LanguageToggle lang={lang} currentPath={currentPath} />
          <ThemeToggle lang={lang} />
        </div>
        <nav class="w-full mt-2 pt-2 border-t border-white/20" aria-label="Primary">
          <ul class="flex flex-wrap items-center justify-center gap-1 list-none">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center justify-center px-2 py-1.5 rounded text-xs transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-white',
                    item.current ? 'bg-white/30 text-white' : 'text-slate-100 hover:bg-white/10',
                  ]}
                  aria-current={item.current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</aside>
