---
import { t, type Lang } from '../lib/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  headings: Heading[];
}

const { lang, headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length >= 2 && (
  <nav class="toc mb-10 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 lg:sticky lg:top-6" aria-label={t(lang, 'toc')}>
    <p class="font-semibold text-gray-800 dark:text-slate-100 mb-3">{t(lang, 'toc')}</p>
    <ol class="space-y-2 text-sm">
      {items.map((heading) => (
        <li class:list={[heading.depth === 3 ? 'pl-4' : '']}>
          <a href={`#${heading.slug}`} class="text-blue-700 dark:text-blue-300 hover:underline">
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
