---
interface Props {
  url: string;
  title: string;
  description?: string;
  type?: 'local' | 'external';
}

const { title, description = '' } = Astro.props;
// url and type are used in script section only
const _url = Astro.props.url;
const _type = Astro.props.type;
---

<div 
  id="post-preview" 
  class="fixed z-50 hidden bg-white rounded-lg shadow-2xl border-2 border-blue-200 overflow-hidden"
  style="width: 400px; max-height: 500px;"
>
  <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-4 text-white">
    <h3 class="font-bold text-lg line-clamp-2" id="preview-title">{title}</h3>
    <p class="text-sm text-blue-100 mt-1 line-clamp-2" id="preview-description" style="display: none;">{description}</p>
  </div>
  <div class="p-4" id="preview-content">
    <div id="preview-iframe-container" style="display: none;">
      <iframe 
        id="preview-iframe"
        src=""
        class="w-full h-64 border-0 rounded"
        loading="lazy"
        style="pointer-events: none;"
      ></iframe>
    </div>
    <div id="preview-external" class="space-y-3" style="display: none;">
      <p class="text-sm text-slate-600" id="preview-external-desc"></p>
      <a 
        id="preview-link"
        href="" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-block px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all text-sm font-medium"
      >
        Read Article →
      </a>
    </div>
  </div>
</div>

<script>
  let hoverTimeout: ReturnType<typeof setTimeout> | null = null;
  let previewElement: HTMLElement | null = null;
  let isPreviewHovered = false;

  function showPreview(card: HTMLElement, url: string, title: string, description: string, type: string) {
    // Clear any existing timeout
    if (hoverTimeout) {
      clearTimeout(hoverTimeout);
      hoverTimeout = null;
    }

    // Set timeout for 5 seconds
    hoverTimeout = setTimeout(() => {
      previewElement = document.getElementById('post-preview');
      if (!previewElement) return;

      // Update preview content
      const titleEl = previewElement.querySelector('#preview-title') as HTMLElement | null;
      const descEl = previewElement.querySelector('#preview-description') as HTMLElement | null;
      const iframeContainer = previewElement.querySelector('#preview-iframe-container') as HTMLElement | null;
      const iframeEl = previewElement.querySelector('#preview-iframe') as HTMLIFrameElement | null;
      const externalContainer = previewElement.querySelector('#preview-external') as HTMLElement | null;
      const externalDesc = previewElement.querySelector('#preview-external-desc') as HTMLElement | null;
      const linkEl = previewElement.querySelector('#preview-link') as HTMLAnchorElement | null;

      if (titleEl) titleEl.textContent = title;
      
      if (type === 'local') {
        // Show iframe for local posts
        if (iframeContainer) iframeContainer.style.display = 'block';
        if (externalContainer) externalContainer.style.display = 'none';
        if (iframeEl) iframeEl.src = url;
        if (descEl) descEl.style.display = description ? 'block' : 'none';
        if (descEl && description) descEl.textContent = description;
      } else {
        // Show external link preview
        if (iframeContainer) iframeContainer.style.display = 'none';
        if (externalContainer) externalContainer.style.display = 'block';
        if (linkEl) {
          linkEl.href = url;
          linkEl.className = 'inline-block px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all text-sm font-medium';
        }
        if (externalDesc) {
          externalDesc.textContent = description || 'Click to read the full article on Medium';
        }
        if (descEl) descEl.style.display = description ? 'block' : 'none';
        if (descEl && description) descEl.textContent = description;
      }

      // Position preview
      const rect = card.getBoundingClientRect();
      const scrollY = window.scrollY || window.pageYOffset;
      const scrollX = window.scrollX || window.pageXOffset;

      let top = rect.bottom + scrollY + 10;
      let left = rect.left + scrollX;

      // Adjust if preview would go off screen
      if (left + 400 > window.innerWidth) {
        left = window.innerWidth - 420;
      }
      if (top + 500 > window.innerHeight + scrollY) {
        top = rect.top + scrollY - 520;
      }

      previewElement.style.top = `${top}px`;
      previewElement.style.left = `${left}px`;
      previewElement.classList.remove('hidden');
      previewElement.classList.add('block');
    }, 5000);
  }

  function hidePreview() {
    if (hoverTimeout) {
      clearTimeout(hoverTimeout);
      hoverTimeout = null;
    }
    if (previewElement && !isPreviewHovered) {
      previewElement.classList.add('hidden');
      previewElement.classList.remove('block');
    }
  }

  // Initialize preview for all post cards
  document.addEventListener('DOMContentLoaded', () => {
    previewElement = document.getElementById('post-preview');
    
    const cards = document.querySelectorAll('[data-post-card]');
    
    cards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const url = cardEl.dataset.url || '';
      const title = cardEl.dataset.title || '';
      const description = cardEl.dataset.description || '';
      const type = cardEl.dataset.type || 'local';

      cardEl.addEventListener('mouseenter', () => {
        isPreviewHovered = false;
        showPreview(cardEl, url, title, description, type);
      });

      cardEl.addEventListener('mouseleave', () => {
        // Small delay to allow moving to preview
        setTimeout(() => {
          if (!isPreviewHovered) {
            hidePreview();
          }
        }, 100);
      });

      // Also hide preview when clicking (to allow normal navigation)
      cardEl.addEventListener('click', () => {
        hidePreview();
      });
    });

    // Keep preview open when hovering over it
    if (previewElement) {
      previewElement.addEventListener('mouseenter', () => {
        isPreviewHovered = true;
      });

      previewElement.addEventListener('mouseleave', () => {
        isPreviewHovered = false;
        hidePreview();
      });
    }
  });
</script>

<style>
  #post-preview {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

