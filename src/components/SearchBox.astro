---
---

<div class="relative mb-8">
  <input
    type="search"
    id="search-box"
    placeholder="Search posts..."
    class="w-full px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
  />
  <div id="search-results" class="hidden mt-2 space-y-2"></div>
</div>

<script>
  let idx: any = null;
  let posts: any[] = [];

  async function initSearch() {
    try {
      const response = await fetch('/search-index.json');
      if (!response.ok) return;
      const indexData = await response.json();
      posts = indexData.posts || [];
      
      if (typeof window !== 'undefined' && (window as any).lunr) {
        idx = (window as any).lunr.Index.load(indexData.index);
      }
    } catch (error) {
      console.error('Failed to load search index:', error);
    }
  }

  function performSearch(query: string) {
    if (!idx || !posts.length) return [];
    
    try {
      const results = idx.search(query);
      return results.map((result: any) => {
        const post = posts.find((p: any) => p.slug === result.ref);
        return post ? { ...post, score: result.score } : null;
      }).filter(Boolean).slice(0, 10);
    } catch (error) {
      console.error('Search error:', error);
      return [];
    }
  }

  const searchBox = document.getElementById('search-box');
  const resultsDiv = document.getElementById('search-results');

  if (typeof window !== 'undefined') {
    initSearch();

    let debounceTimer: ReturnType<typeof setTimeout>;
    searchBox?.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const query = (e.target as HTMLInputElement).value.trim();
        if (query.length < 2) {
          resultsDiv?.classList.add('hidden');
          if (resultsDiv) resultsDiv.innerHTML = '';
          return;
        }

        const results = performSearch(query);
        
        if (!resultsDiv) return;
        
        if (results.length === 0) {
          resultsDiv.innerHTML = '<p class="text-gray-500">No results found.</p>';
          resultsDiv.classList.remove('hidden');
          return;
        }

        resultsDiv.innerHTML = results.map((post: any) => `
          <a href="/${post.lang}/blog/${post.slug}" class="block p-3 border border-gray-300 rounded-lg hover:bg-gray-100">
            <h3 class="font-semibold">${post.title}</h3>
            ${post.description ? `<p class="text-sm text-gray-600 mt-1">${post.description}</p>` : ''}
          </a>
        `).join('');
        
        resultsDiv.classList.remove('hidden');
      }, 300);
    });
  }
</script>


