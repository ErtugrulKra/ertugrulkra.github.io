---
import { t, type Lang } from '../lib/i18n';

interface Props {
  post: {
    title: string;
    pubDate: Date;
    description?: string;
    tags?: string[];
    author?: string;
    lang: string;
    readingMinutes?: number;
  };
  slug: string;
  lang: string;
}

const { post, slug, lang } = Astro.props;
const { title, pubDate, description, tags = [], readingMinutes } = post;
const prefix = lang === 'tr' ? '/tr' : '';
const uiLang = (lang === 'tr' ? 'tr' : 'en') as Lang;
---

<article
  class="h-full flex flex-col border-2 border-gray-200 dark:border-slate-700 rounded-lg p-5 hover:shadow-xl transition-all bg-white dark:bg-slate-800 shadow-sm hover:border-blue-500 motion-reduce:transform-none hover:scale-105 motion-reduce:hover:scale-100 transform"
>
  <h2 class="text-xl font-bold mb-2">
    <a href={`${prefix}/blog/${slug}`} class="text-gray-800 dark:text-slate-100 hover:text-blue-600 transition-colors">{title}</a>
  </h2>

  {description && <p class="text-gray-600 dark:text-slate-300 mb-4 line-clamp-3">{description}</p>}

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: string) => (
        <a
          href={`${prefix}/tags/${tag}`}
          class="px-2 py-1 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded text-sm hover:bg-blue-100 hover:text-blue-700 transition-all font-medium"
        >
          {tag}
        </a>
      ))}
    </div>
  )}

  <div class="mt-auto pt-4 flex items-end justify-between gap-3 text-sm text-gray-500 dark:text-slate-400">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 min-w-0">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {readingMinutes && (
        <span class="whitespace-nowrap">· {readingMinutes} {t(uiLang, 'minRead')}</span>
      )}
    </div>
    <a href={`${prefix}/blog/${slug}`} class="shrink-0 whitespace-nowrap text-blue-600 dark:text-blue-400 hover:underline font-medium">
      {t(uiLang, 'readMore')}
    </a>
  </div>
</article>
