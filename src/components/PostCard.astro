---
interface Props {
  post: {
    title: string;
    pubDate: Date;
    description?: string;
    tags?: string[];
    author?: string;
    lang: string;
  };
  slug: string;
  lang: string;
}

const { post, slug, lang } = Astro.props;
const { title, pubDate, description, tags = [] } = post;
---

<article
  class="border border-gray-300 rounded-lg p-6 hover:shadow-lg transition-shadow bg-slate-50 shadow-sm"
>
  <h2 class="text-xl font-bold mb-2">
    <a href={`/blog/${slug}/`} class="text-slate-700 hover:text-slate-900">{title}</a>
  </h2>
  
  {description && <p class="text-slate-600 mb-4">{description}</p>}
  
  <div class="flex flex-wrap gap-2 mb-4">
    {tags.map((tag: string) => (
      <a
        href={`/tags/${tag}/`}
        class="px-2 py-1 bg-slate-100 text-slate-700 rounded text-sm hover:bg-slate-200 transition-colors"
      >
        {tag}
      </a>
    ))}
  </div>
  
  <div class="flex items-center justify-between text-sm text-slate-500">
    <time datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
    <a href={`/blog/${slug}/`} class="text-slate-600 hover:text-slate-800 hover:underline">
      Read more →
    </a>
  </div>
</article>

