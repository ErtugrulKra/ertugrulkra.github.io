---
interface Props {
  post: {
    title: string;
    pubDate: Date;
    description?: string;
    tags?: string[];
    author?: string;
    lang: string;
  };
  slug: string;
  lang: string;
}

const { post, slug, lang } = Astro.props;
const { title, pubDate, description, tags = [] } = post;
---

<article
  class="border-2 border-gray-200 rounded-lg p-5 hover:shadow-xl transition-all bg-white shadow-sm hover:border-blue-500 hover:scale-105 transform"
  data-post-card
  data-url={`/blog/${slug}`}
  data-title={title}
  data-description={description || ''}
  data-type="local"
>
  <h2 class="text-xl font-bold mb-2">
    <a href={`/blog/${slug}`} class="text-gray-800 hover:text-blue-600 transition-colors">{title}</a>
  </h2>
  
  {description && <p class="text-gray-600 mb-4">{description}</p>}
  
  <div class="flex flex-wrap gap-2 mb-4">
    {tags.map((tag: string) => (
      <a
        href={`/tags/${tag}`}
        class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-sm hover:bg-blue-100 hover:text-blue-700 transition-all font-medium"
      >
        {tag}
      </a>
    ))}
  </div>
  
  <div class="flex items-center justify-between text-sm text-gray-500">
    <time datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
    <a href={`/blog/${slug}`} class="text-blue-600 hover:text-blue-700 hover:underline font-medium">
      Read more →
    </a>
  </div>
</article>

