---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  current: number;
  totalPages: number;
  prevHref?: string;
  nextHref?: string;
}

const { lang, current, totalPages, prevHref, nextHref } = Astro.props;
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-4 mt-10" aria-label={t(lang, 'pageLabel')}>
    {prevHref ? (
      <a href={prevHref} class="px-4 py-2 rounded-lg border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-200 hover:bg-gray-100 dark:hover:bg-slate-800">
        {t(lang, 'prev')}
      </a>
    ) : (
      <span class="px-4 py-2 rounded-lg border border-gray-200 dark:border-slate-700 text-gray-400">{t(lang, 'prev')}</span>
    )}
    <p class="text-sm text-gray-600 dark:text-slate-300">
      {t(lang, 'pageLabel')} {current} / {totalPages}
    </p>
    {nextHref ? (
      <a href={nextHref} class="px-4 py-2 rounded-lg border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-200 hover:bg-gray-100 dark:hover:bg-slate-800">
        {t(lang, 'next')}
      </a>
    ) : (
      <span class="px-4 py-2 rounded-lg border border-gray-200 dark:border-slate-700 text-gray-400">{t(lang, 'next')}</span>
    )}
  </nav>
)}
