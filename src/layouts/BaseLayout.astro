---
import PostPreview from '@components/PostPreview.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  currentPath?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  tags?: string[];
}

const {
  title,
  description = 'Personal website of Ertugrul Kara',
  lang = 'en',
  currentPath = '/',
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  authorName = 'Ertugrul Kara',
  tags = []
} = Astro.props as Props;
const canonical = new URL(currentPath, Astro.site);
const ogImage = image || new URL('/og-image.png', Astro.site).href;
const counterpart =
  lang === 'en'
    ? canonical.href.replace('/en/', '/tr/')
    : canonical.href.replace('/tr/', '/en/');
const xDefault =
  lang === 'en'
    ? canonical.href
    : canonical.href.replace('/tr/', '/en/');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content={authorName} />
    <meta name="language" content={lang} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- Additional SEO Meta Tags -->
    <meta name="theme-color" content="#2563eb" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ertugrul Kara" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />
    {lang === 'tr' && (
      <meta property="og:locale:alternate" content="en_US" />
    )}
    {lang === 'en' && (
      <meta property="og:locale:alternate" content="tr_TR" />
    )}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === 'article' && (
      <meta property="article:author" content={authorName} />
    )}
    {type === 'article' && tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Hreflang -->
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    {lang === 'en' ? (
      <>
        <link rel="alternate" hreflang="en" href={canonical} />
        <link rel="alternate" hreflang="tr" href={counterpart} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="tr" href={canonical} />
        <link rel="alternate" hreflang="en" href={counterpart} />
      </>
    )}
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Lunr.js for search -->
    <script src="https://unpkg.com/lunr@2.3.9/lunr.min.js"></script>

    <!-- Structured Data: WebSite -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Ertugrul Kara',
        url: new URL('/', Astro.site).href,
        description: 'Personal website and blog of Ertugrul Kara - Software Engineer, Architect',
        inLanguage: lang,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: new URL('/search?q={search_term_string}', Astro.site).href
          },
          'query-input': 'required name=search_term_string'
        }
      })}
    </script>

    <!-- Structured Data: Person (Publisher) -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Ertugrul Kara',
        url: new URL('/', Astro.site).href,
        jobTitle: 'Software Engineer, Architect',
        description: 'Software architect who enjoys designing scalable software systems and working with engineering teams.',
        sameAs: [
          'https://github.com/ertugrulkra',
          'https://www.linkedin.com/in/ertugrul-kra/',
          'https://medium.com/@ertugrulkra'
        ],
        email: 'hello@ertugrulkara.com',
        image: new URL('/avatar.jpg', Astro.site).href
      })}
    </script>

    {type === 'article' && (
      <script type="application/ld+json">
        {JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title,
          description,
          image: [ogImage],
          author: {
            '@type': 'Person',
            name: authorName,
            url: new URL('/', Astro.site).href
          },
          publisher: {
            '@type': 'Person',
            name: authorName,
            url: new URL('/', Astro.site).href
          },
          datePublished: publishedTime || undefined,
          dateModified: modifiedTime || publishedTime || undefined,
          inLanguage: lang,
          mainEntityOfPage: {
            '@type': 'WebPage',
            '@id': canonical.href
          },
          keywords: tags.length > 0 ? tags.join(', ') : undefined
        })}
      </script>
    )}
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter', sans-serif;
  }
  
  html {
    font-family: var(--font-sans);
  }
</style>

