---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: string;
}

const { post, lang } = Astro.props;
const { data } = post;

const tags = data.tags || [];
const publishDate = new Date(data.pubDate);
---

<article class="prose prose-lg dark:prose-invert max-w-4xl mx-auto">
  <header class="mb-12">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">{data.title}</h1>
    
    <div class="flex flex-wrap items-center gap-4 text-gray-600 dark:text-gray-400 mb-6">
      <time datetime={publishDate.toISOString()}>
        {publishDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      
      {data.author && <span>by {data.author}</span>}
    </div>
    
    {data.description && (
      <p class="text-xl text-gray-600 dark:text-gray-400">{data.description}</p>
    )}
    
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.map((tag) => (
          <a
            href={`/${lang}/tags/${tag}`}
            class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </header>
  
  <div class="post-content">
    <slot />
  </div>
  
  <hr class="my-12 border-gray-200 dark:border-gray-800" />
  
  <footer class="text-center">
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Share this post:
    </p>
    <div class="flex justify-center gap-4">
      <a
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(Astro.url)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors"
      >
        Twitter
      </a>
      <a
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </footer>
</article>

<style>
  :global(.post-content h2) {
    @apply text-3xl font-bold mt-12 mb-4;
  }
  
  :global(.post-content h3) {
    @apply text-2xl font-bold mt-8 mb-3;
  }
  
  :global(.post-content p) {
    @apply mb-4 leading-relaxed;
  }
  
  :global(.post-content a) {
    @apply text-blue-600 dark:text-blue-400 underline;
  }
  
  :global(.post-content code) {
    @apply bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-sm;
  }
  
  :global(.post-content pre) {
    @apply bg-gray-100 dark:bg-gray-800 p-4 rounded-lg overflow-x-auto mb-4;
  }
  
  :global(.post-content ul, .post-content ol) {
    @apply mb-4 pl-6;
  }
  
  :global(.post-content ul) {
    @apply list-disc;
  }
  
  :global(.post-content ol) {
    @apply list-decimal;
  }
  
  :global(.post-content blockquote) {
    @apply border-l-4 border-blue-500 pl-4 italic text-gray-600 dark:text-gray-400 my-4;
  }
</style>

