---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import MediumPostCard from '@components/MediumPostCard.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';

// Get regular posts
const posts = await getCollection('en-posts', ({ data }) => {
  return data.lang === 'en';
});

// Try to load Medium posts
let mediumPosts = [];
try {
  const mediumPostsPath = path.join(process.cwd(), 'src/content/_medium/posts.json');
  if (fs.existsSync(mediumPostsPath)) {
    const fileContent = fs.readFileSync(mediumPostsPath, 'utf-8');
    mediumPosts = JSON.parse(fileContent);
  }
} catch (e) {
  console.error('Error loading Medium posts:', e);
}

// Combine all posts
const allPosts = [
  ...posts.map(p => ({
    type: 'local',
    slug: p.slug,
    title: p.data.title,
    description: p.data.description || '',
    pubDate: p.data.pubDate,
    tags: p.data.tags || [],
    author: p.data.author || 'Ertugrul Kara',
    lang: 'en',
  })),
  ...mediumPosts.map((m: any) => ({
    type: 'medium',
    title: m.title,
    link: m.link,
    pubDate: new Date(m.pubDate),
    contentSnippet: m.contentSnippet,
    categories: m.categories,
    guid: m.guid,
    author: m.author,
    lang: 'en',
  })),
];

// Sort and take recent 6
const recentPosts = allPosts
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
  .slice(0, 6);
  
const totalPosts = allPosts.length;
---

<BaseLayout
  title="Ertugrul Kara - Software Developer"
  description="Personal website and blog of Ertugrul Kara"
  lang="en"
  currentPath="/"
>
  <div class="container mx-auto px-4 py-16">
    <section class="mb-16">
      <h1 class="text-5xl font-bold mb-4">
        Hi, I'm <span class="bg-gradient-to-r from-blue-600 via-cyan-500 to-teal-600 bg-clip-text text-transparent">Ertugrul Kara</span>
      </h1>
      <p class="text-xl text-slate-700 mb-8">
        A passionate software developer who loves building things that make a difference.
      </p>
      <div class="flex gap-4">
        <a
          href="/blog/"
          class="px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-lg hover:from-blue-700 hover:to-cyan-700 transition-all shadow-lg hover:shadow-xl transform hover:scale-105 font-medium"
        >
          View Blog
        </a>
        <a
          href="/about/"
          class="px-6 py-3 border-2 border-blue-400 text-blue-600 rounded-lg hover:bg-blue-50 transition-colors font-medium"
        >
          About Me
        </a>
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold mb-8 bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">Recent Posts</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post) => {
          if (post.type === 'local') {
            return (
              <PostCard 
                post={{
                  title: post.title,
                  pubDate: post.pubDate,
                  description: post.description,
                  tags: post.tags,
                  author: post.author,
                  lang: post.lang,
                }} 
                slug={post.slug} 
                lang="en" 
              />
            );
          } else {
            return (
              <MediumPostCard post={post} lang="en" />
            );
          }
        })}
      </div>
      {totalPosts > 6 && (
        <div class="text-center mt-8">
          <a
            href="/blog/"
            class="inline-block px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-lg hover:from-blue-700 hover:to-cyan-700 transition-all shadow-lg hover:shadow-xl transform hover:scale-105 font-medium"
          >
            View All Posts
          </a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

