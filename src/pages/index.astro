---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';
import PostList from '@components/PostList.astro';
import { getCombinedPosts } from '../lib/posts';
import aboutPhoto from '../../public/about-photo.png';

const posts = await getCombinedPosts('en');
const recentPosts = posts.slice(0, 6);
const totalPosts = posts.length;
---

<BaseLayout
  title="Ertugrul Kara - Software Engineer & Architect | Blog"
  description="Software Engineer and Architect specializing in scalable systems, cloud-based e-Invoice and e-Signature systems, microservices, and DevOps. Read technical article summaries here; full pieces are published on Medium."
  lang="en"
  currentPath="/"
>
  <PageShell lang="en" currentPath="/">
    <section class="mb-12">
      <div class="grid md:grid-cols-2 gap-8 items-start mb-6">
        <div>
          <h1 class="text-5xl font-bold mb-3 text-gray-800 dark:text-slate-100">
            Ertugrul Kara
          </h1>
          <p class="text-2xl text-gray-600 dark:text-slate-300 mb-4">
            Software Engineer, Architect
          </p>
          <div class="space-y-4 mb-6">
            <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
              A software architect who enjoys designing scalable software systems and working with engineering teams.
              Passionate about cloud-based e-Invoice and e-Signature systems, distributed applications, and microservice frameworks.
            </p>
            <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
              Enthusiastic about learning modern technologies, improving development processes, and connecting technical solutions with business goals.
              Experienced in Agile team management, DevOps practices, and delivering software solutions for different industries.
            </p>
          </div>
        </div>
        <div class="flex justify-center md:justify-end">
          <Image
            src={aboutPhoto}
            alt="Ertugrul Kara"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 607px"
            loading="eager"
            fetchpriority="high"
            class="w-full max-w-[607px] h-auto rounded-lg shadow-lg object-cover"
          />
        </div>
      </div>
      <div class="flex gap-4">
        <a
          href="/blog"
          class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium flex items-center gap-2"
        >
          <span>View Blog</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/about"
          class="px-6 py-3 bg-gray-700 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium flex items-center gap-2"
        >
          <span>View Resume</span>
        </a>
      </div>
    </section>

    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-1 h-10 bg-blue-600"></div>
        <h2 class="text-3xl font-bold text-gray-800 dark:text-slate-100">What I Do</h2>
      </div>
      <p class="text-gray-700 dark:text-slate-300 leading-relaxed mb-6">
        With over 18 years of experience in software development, I specialize in designing and building scalable, high-performance applications and distributed systems.
        My expertise spans across software architecture, cloud-based e-Invoice and e-Signature systems, microservice frameworks, team leadership, and DevOps practices.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          ['C#', 'C# .NET', 'Enterprise applications'],
          ['🐍', 'Python FastAPI', 'Modern API development'],
          ['📦', 'DevOps', 'CI/CD & Automation'],
          ['☁️', 'Cloud', 'AWS & Azure'],
          ['⚡', 'Microservices', 'Distributed systems'],
          ['🔧', 'Code Refactoring', 'Code quality & optimization'],
          ['🌐', 'ASP.NET', 'Web applications'],
          ['🤖', 'AI - LLM - ML', 'Machine Learning'],
        ].map(([icon, name, detail]) => (
          <div class="bg-white dark:bg-slate-800 border-2 border-gray-200 dark:border-slate-700 rounded-lg p-4 hover:border-blue-500 hover:shadow-lg transition-all">
            <div class="text-3xl mb-2">{icon}</div>
            <h3 class="font-bold text-gray-800 dark:text-slate-100 mb-1 text-sm">{name}</h3>
            <p class="text-xs text-gray-600 dark:text-slate-400">{detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold mb-6 text-gray-800 dark:text-slate-100">Recent Posts</h2>
      <PostList posts={recentPosts} lang="en" />
      {totalPosts > 6 && (
        <div class="text-center mt-8">
          <a
            href="/blog"
            class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            View All Posts
          </a>
        </div>
      )}
    </section>
  </PageShell>
</BaseLayout>
