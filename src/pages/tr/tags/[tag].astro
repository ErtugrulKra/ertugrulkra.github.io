---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';
import PostList from '@components/PostList.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getAllTags, getCombinedPosts } from '../../../lib/posts';
import { localePath, t } from '../../../lib/i18n';

export async function getStaticPaths() {
  const tags = await getAllTags('tr');
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getCombinedPosts('tr')).filter((post) => post.tags.includes(tag || ''));
const currentPath = `/tr/tags/${tag}`;
const breadcrumbs = [
  { name: t('tr', 'home'), href: '/tr' },
  { name: t('tr', 'tags'), href: localePath('tr', '/tags') },
  { name: tag || '', href: currentPath },
];
---

<BaseLayout
  title={`Etiket: ${tag} - Ertugrul Kara`}
  description={`Ertugrul Kara’nın ${tag} etiketli yazı özetleri.`}
  lang="tr"
  currentPath={currentPath}
  breadcrumbs={breadcrumbs}
>
  <PageShell lang="tr" currentPath={currentPath}>
    <Breadcrumbs items={breadcrumbs} />
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4 text-gray-800 dark:text-slate-100">
        {tag} etiketli yazılar
      </h1>
      <p class="text-xl text-gray-600 dark:text-slate-300">
        {posts.length} yazı bulundu
      </p>
    </header>
    <PostList posts={posts} lang="tr" />
    {posts.length === 0 && (
      <p class="text-center text-gray-500 mt-12">{t('tr', 'noPostsTag')}</p>
    )}
  </PageShell>
</BaseLayout>
