---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';

const experience = [
  {
    title: 'Kıdemli Yazılım Mimarı',
    company: 'Odeon Yazılım ve Teknoloji',
    location: 'Türkiye',
    responsibilities: [
      'Ürün mühendisliği ekipleri için yazılım mimarisi ve teknik yön belirleme.',
      'Ölçeklenebilir servisler tasarlama; bulut, entegrasyon ve teslimat pratiklerinde rehberlik.',
      'Teknik çözümleri iş hedefleriyle hizalamak için paydaşlarla çalışma.',
    ],
  },
  {
    title: 'Yazılım Danışmanı | Ekip Lideri',
    company: 'e-Logo (Logo Yazılım A.Ş.)',
    location: 'Türkiye',
    responsibilities: [
      'e-Fatura uyumluluğu için ölçeklenebilir bir Mikroservis Framework tasarladım ve geliştirdim.',
      '12 kişilik mühendislik ekibini yönettim ve mentörlük yaptım, Agile/Scrum dönüşümünü yönlendirdim.',
      'Büyük ölçekli belge depolama ve işleme için dağıtık sistemler geliştirdim.',
      'DevOps entegrasyonunu yönettim, CI/CD pipeline\'larını ve sistem otomasyonunu optimize ettim.',
    ],
  },
  {
    title: 'Yazılım Ekip Lideri',
    company: 'Foriba (Sovos)',
    location: 'Türkiye',
    responsibilities: [
      'Yurt içi ve yurt dışı müşteriler için çok sayıda bulut tabanlı e-Fatura ve e-İmza projesini yönettim.',
      'Zamanında teslimat ve düzenleyici uyumluluğu sağlayan Agile proje ekiplerine liderlik ettim.',
      'ING Bank INGeF e-Fatura Bulut Platformu ve Türkiye Noterler Birliği e-Fatura Sistemini tasarladım.',
      'Kurumsal müşteriler için yüksek hacimli B2B bulut uygulamaları geliştirdim ve bakımını yaptım.',
    ],
  },
  {
    title: 'Kıdemli Yazılım Geliştirici',
    company: 'Koyuncu Elektronik',
    location: 'Türkiye',
    responsibilities: [
      'Ödeme entegrasyon sistemleri ve SAP entegre B2B uygulamaları geliştirdim.',
      'İşlem işleme için MongoDB destekli dağıtık veri sistemi oluşturdum.',
    ],
  },
  {
    title: 'Yazılım Geliştirici',
    company: 'Insoft - Ergin Elektrik A.Ş',
    location: 'Türkiye',
    responsibilities: [
      'Java EE ve Oracle tabanlı veritabanlarını entegre eden ERP destek uygulamaları geliştirdim.',
      'Endüstriyel müşteriler için enerji izleme ve raporlama sistemleri oluşturdum.',
    ],
  },
  {
    title: 'Yazılım Geliştirici',
    company: 'Kalem Yazılım',
    location: 'Türkiye',
    responsibilities: [
      'Casper Computer Systems için üretim planlama uygulamaları tasarladım.',
      'Logo Go ve Unity ERP sistemlerini müşteri operasyonlarına entegre ettim.',
    ],
  },
];

const education = [
  {
    degree: 'Bilgisayar Mühendisliği Lisans',
    institution: 'Üsküdar Üniversitesi',
    location: 'Türkiye',
  },
  {
    degree: 'Yönetim Bilişim Sistemleri Lisans',
    institution: 'İstanbul Üniversitesi',
    location: 'Türkiye',
  },
  {
    degree: 'Bilgisayar Teknolojisi ve Programlama Ön Lisans',
    institution: 'İstanbul Üniversitesi',
    location: 'Türkiye',
  },
];

const certifications = [
  'İleri Python Programlama (BT Akademi, İstanbul)',
  'Aspect-Oriented Programlama (Bilge Adam, İstanbul)',
  'Microsoft Uygulama Geliştirici (Netron, İstanbul)',
  'Docker & Kubernetes (Fikrimuhal, İstanbul)',
  'Microsoft Certified Professional (Microsoft)',
  'Lider Olarak İlham Verici Liderlik (Baltaş, İstanbul)',
];
---

<BaseLayout
  title="Hakkımda - Ertugrul Kara"
  description="Ertugrul Kara, mikroservisler, bulut e-Fatura sistemleri ve mühendislik liderliği üzerine çalışan yazılım mimarı."
  lang="tr"
  currentPath="/tr/about"
>
  <PageShell lang="tr" currentPath="/tr/about">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4 text-gray-800 dark:text-slate-100">Hakkımda</h1>
      <p class="text-xl text-slate-600 dark:text-slate-300">
        Mikroservisler, bulut bilişim ve kurumsal çözümler konularına tutkulu, deneyimli yazılım mühendisi ve ekip lideri.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-slate-100">Profesyonel Özet</h2>
      <p class="text-slate-700 dark:text-slate-300 mb-4 leading-relaxed">
        Ölçeklenebilir yazılım sistemleri tasarlamayı ve mühendislik ekipleriyle çalışmayı seven bir yazılım mimarı. 
        Bulut tabanlı e-Fatura ve e-İmza sistemleri, dağıtık uygulamalar ve mikroservis framework'leri konularına meraklı.
      </p>
      <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
        Modern teknolojileri öğrenmeye hevesli, geliştirme süreçlerini iyileştirmeye istekli ve teknik çözümleri iş hedefleriyle buluşturmaktan hoşlanan biri. 
        Farklı endüstrilerde Agile ekip yönetimi, DevOps uygulamaları ve yazılım çözümleri sunma konularında deneyimli.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-slate-100">İletişim</h2>
      <div class="space-y-2 text-gray-800 dark:text-slate-100">
        <p>
          <strong>E-posta:</strong>{' '}
          <a href="mailto:hello@ertugrulkara.com" class="hover:underline text-blue-600 dark:text-blue-400">
            hello@ertugrulkara.com
          </a>
        </p>
        <p>
          <strong>GitHub:</strong>{' '}
          <a href="https://github.com/ertugrulkra" target="_blank" rel="noopener noreferrer" class="hover:underline text-blue-600 dark:text-blue-400">
            github.com/ertugrulkra
          </a>
        </p>
        <p>
          <strong>LinkedIn:</strong>{' '}
          <a href="https://www.linkedin.com/in/ertugrul-kra/" target="_blank" rel="noopener noreferrer" class="hover:underline text-blue-600 dark:text-blue-400">
            linkedin.com/in/ertugrul-kra
          </a>
        </p>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-slate-100">İş Deneyimi</h2>
      <div class="space-y-8">
        {experience.map((exp) => (
          <div class="border-l-4 border-blue-500 pl-6 bg-slate-50 dark:bg-slate-800 p-4 rounded-r-lg">
            <h3 class="font-bold text-lg text-slate-800 dark:text-slate-100">{exp.title}</h3>
            <p class="text-slate-600 dark:text-slate-400 font-medium">{exp.company} • {exp.location}</p>
            <ul class="list-disc list-inside space-y-1 text-slate-700 dark:text-slate-300 mt-3">
              {exp.responsibilities.map((resp) => (
                <li>{resp}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-slate-100">Eğitim</h2>
      <div class="space-y-4">
        {education.map((edu) => (
          <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-lg border border-transparent dark:border-slate-700">
            <h3 class="font-bold text-slate-800 dark:text-slate-100">{edu.degree}</h3>
            <p class="text-slate-600 dark:text-slate-400">{edu.institution} • {edu.location}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-slate-100">Sertifikalar</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {certifications.map((cert) => (
          <div class="bg-slate-50 dark:bg-slate-800 p-3 rounded-lg text-sm text-slate-700 dark:text-slate-300 border border-transparent dark:border-slate-700">
            {cert}
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-slate-100">Diller</h2>
      <div class="space-y-2">
        <div class="flex justify-between items-center bg-slate-50 dark:bg-slate-800 p-3 rounded-lg border border-transparent dark:border-slate-700">
          <span class="font-medium text-slate-800 dark:text-slate-100">Türkçe</span>
          <span class="text-sm text-slate-600 dark:text-slate-400">Anadil</span>
        </div>
        <div class="flex justify-between items-center bg-slate-50 dark:bg-slate-800 p-3 rounded-lg border border-transparent dark:border-slate-700">
          <span class="font-medium text-slate-800 dark:text-slate-100">İngilizce</span>
          <span class="text-sm text-slate-600 dark:text-slate-400">B2 Seviye</span>
        </div>
      </div>
    </section>
  </PageShell>
</BaseLayout>
