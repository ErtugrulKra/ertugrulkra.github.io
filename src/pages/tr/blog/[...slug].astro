---
import BaseLayout from '@layouts/BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('tr-posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={`${post.data.title} - Ertugrul Kara`}
  description={post.data.description || post.data.title}
  lang="tr"
  currentPath={`/tr/blog/${post.slug}`}
>
  <div class="flex">
    <!-- Sidebar -->
    <Sidebar currentPath={`/tr/blog/${post.slug}`} lang="tr" />

    <!-- Main Content -->
    <main class="flex-1 lg:ml-80 bg-white min-h-screen">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 lg:py-8">
        <article class="prose prose-lg max-w-none">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">{post.data.title}</h1>
        
        <div class="flex flex-wrap items-center gap-4 text-slate-600 mb-6">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('tr-TR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          
          {post.data.author && <span>by {post.data.author}</span>}
        </div>
        
        {post.data.description && (
          <p class="text-xl text-slate-700">{post.data.description}</p>
        )}
        
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {post.data.tags.map((tag) => (
              <a
                href={`/tr/tags/${tag}`}
                class="px-3 py-1 bg-gradient-to-r from-blue-100 to-cyan-100 text-blue-700 rounded-full text-sm hover:from-blue-200 hover:to-cyan-200 transition-all font-medium"
              >
                {tag}
              </a>
            ))}
          </div>
        )}
      </header>
      
      <div class="post-content">
        <Content />
      </div>
    </article>
      </div>
      <Footer />
    </main>
  </div>
</BaseLayout>

<style>
  :global(.post-content h2) {
    @apply text-3xl font-bold mt-12 mb-4 text-blue-700;
  }
  
  :global(.post-content h3) {
    @apply text-2xl font-bold mt-8 mb-3 text-cyan-600;
  }
  
  :global(.post-content p) {
    @apply mb-4 leading-relaxed text-gray-700;
  }
  
  :global(.post-content a) {
    @apply text-blue-600 hover:text-cyan-600 underline transition-colors;
  }
  
  :global(.post-content code) {
    @apply bg-blue-100 text-blue-800 px-1 py-0.5 rounded text-sm font-mono;
  }
  
  :global(.post-content pre) {
    @apply bg-gradient-to-r from-blue-50 to-cyan-50 border-2 border-blue-200 p-4 rounded-lg overflow-x-auto mb-4;
  }
  
  :global(.post-content ul, .post-content ol) {
    @apply mb-4 pl-6;
  }
  
  :global(.post-content ul) {
    @apply list-disc;
  }
  
  :global(.post-content ol) {
    @apply list-decimal;
  }
  
  :global(.post-content blockquote) {
    @apply border-l-4 border-blue-400 pl-4 italic text-slate-700 my-4 bg-slate-50 py-2 rounded-r;
  }
</style>

