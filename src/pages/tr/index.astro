---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';
import PostList from '@components/PostList.astro';
import { getCombinedPosts } from '../../lib/posts';
import aboutPhoto from '../../../public/about-photo.png';

const posts = await getCombinedPosts('tr');
const recentPosts = posts.slice(0, 6);
const totalPosts = posts.length;
---

<BaseLayout
  title="Ertugrul Kara - Yazılım Mühendisi & Mimari | Blog"
  description="Ölçeklenebilir sistemler, e-Fatura, mikroservisler ve DevOps üzerine yazılar. Özetler bu sitede; tam metinler Medium’da."
  lang="tr"
  currentPath="/tr"
>
  <PageShell lang="tr" currentPath="/tr">
    <section class="mb-12">
      <div class="grid md:grid-cols-2 gap-8 items-start mb-6">
        <div>
          <h1 class="text-5xl font-bold mb-3 text-gray-800 dark:text-slate-100">
            Ertugrul Kara
          </h1>
          <p class="text-2xl text-gray-600 dark:text-slate-300 mb-4">
            Yazılım Mühendisi, Mimar
          </p>
          <div class="space-y-4 mb-6">
            <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
              Ölçeklenebilir yazılım sistemleri tasarlamayı ve mühendislik ekipleriyle çalışmayı seven bir yazılım mimarıyım.
              Bulut tabanlı e-Fatura ve e-İmza sistemleri, dağıtık uygulamalar ve mikroservis çerçeveleri üzerine çalışıyorum.
            </p>
            <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
              Modern teknolojileri öğrenmeye, geliştirme süreçlerini iyileştirmeye ve teknik çözümleri iş hedefleriyle bağdaştırmaya odaklanıyorum.
            </p>
          </div>
        </div>
        <div class="flex justify-center md:justify-end">
          <Image
            src={aboutPhoto}
            alt="Ertugrul Kara"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 607px"
            loading="eager"
            fetchpriority="high"
            class="w-full max-w-[607px] h-auto rounded-lg shadow-lg object-cover"
          />
        </div>
      </div>
      <div class="flex gap-4">
        <a
          href="/tr/blog"
          class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          Blog'a Git
        </a>
        <a
          href="/tr/about"
          class="px-6 py-3 bg-gray-700 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium"
        >
          Hakkımda
        </a>
      </div>
    </section>

    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-1 h-10 bg-blue-600"></div>
        <h2 class="text-3xl font-bold text-gray-800 dark:text-slate-100">Ne Yapıyorum</h2>
      </div>
      <p class="text-gray-700 dark:text-slate-300 leading-relaxed mb-6">
        18 yılı aşkın yazılım deneyimiyle ölçeklenebilir uygulamalar ve dağıtık sistemler tasarlıyorum.
        Uzmanlık alanlarım yazılım mimarisi, bulut tabanlı e-Fatura ve e-İmza, mikroservisler, ekip liderliği ve DevOps.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          ['C#', 'C# .NET', 'Kurumsal uygulamalar'],
          ['🐍', 'Python FastAPI', 'Modern API geliştirme'],
          ['📦', 'DevOps', 'CI/CD ve otomasyon'],
          ['☁️', 'Cloud', 'AWS ve Azure'],
          ['⚡', 'Mikroservisler', 'Dağıtık sistemler'],
          ['🔧', 'Refactoring', 'Kod kalitesi'],
          ['🌐', 'ASP.NET', 'Web uygulamaları'],
          ['🤖', 'AI - LLM - ML', 'Makine öğrenmesi'],
        ].map(([icon, name, detail]) => (
          <div class="bg-white dark:bg-slate-800 border-2 border-gray-200 dark:border-slate-700 rounded-lg p-4 hover:border-blue-500 hover:shadow-lg transition-all">
            <div class="text-3xl mb-2">{icon}</div>
            <h3 class="font-bold text-gray-800 dark:text-slate-100 mb-1 text-sm">{name}</h3>
            <p class="text-xs text-gray-600 dark:text-slate-400">{detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold mb-6 text-gray-800 dark:text-slate-100">Son Yazılar</h2>
      <PostList posts={recentPosts} lang="tr" />
      {totalPosts > 6 && (
        <div class="text-center mt-8">
          <a
            href="/tr/blog"
            class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            Tüm Yazıları Gör
          </a>
        </div>
      )}
    </section>
  </PageShell>
</BaseLayout>
