---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import MediumPostCard from '@components/MediumPostCard.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';

// Get regular posts
const posts = await getCollection('tr-posts', ({ data }) => {
  return data.lang === 'tr';
});

// Try to load Medium posts
let mediumPosts = [];
try {
  const mediumPostsPath = path.join(process.cwd(), 'src/content/_medium/posts.json');
  if (fs.existsSync(mediumPostsPath)) {
    const fileContent = fs.readFileSync(mediumPostsPath, 'utf-8');
    mediumPosts = JSON.parse(fileContent);
  }
} catch (e) {
  console.error('Error loading Medium posts:', e);
}

// Combine all posts
const allPosts = [
  ...posts.map(p => ({
    type: 'local',
    slug: p.slug,
    title: p.data.title,
    description: p.data.description || '',
    pubDate: p.data.pubDate,
    tags: p.data.tags || [],
    author: p.data.author || 'Ertugrul Kara',
    lang: 'tr',
  })),
  ...mediumPosts.map((m: any) => ({
    type: 'medium',
    title: m.title,
    link: m.link,
    pubDate: new Date(m.pubDate),
    contentSnippet: m.contentSnippet,
    categories: m.categories,
    guid: m.guid,
    author: m.author,
    lang: 'tr',
  })),
];

// Sort and take recent 6
const recentPosts = allPosts
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
  .slice(0, 6);
  
const totalPosts = allPosts.length;
---

<BaseLayout
  title="Ertugrul Kara - Yazılım Mühendisi & Mimari | Blog"
  description="Ölçeklenebilir sistemler, bulut tabanlı e-Fatura ve e-İmza sistemleri, mikroservisler ve DevOps konularında uzman Yazılım Mühendisi ve Mimari. Yazılım geliştirme, mimari ve mühendislik en iyi uygulamaları hakkında teknik makaleler ve içgörüler okuyun."
  lang="tr"
  currentPath="/tr/"
>
  <div class="container mx-auto px-4 py-16">
    <section class="mb-16">
      <h1 class="text-5xl font-bold mb-4">
        Merhaba, Ben <span class="text-slate-700">Ertugrul Kara</span>
      </h1>
      <p class="text-xl text-slate-600 mb-8">
        Fark yaratan şeyler inşa etmeyi seven tutkulu bir yazılım geliştiricisi.
      </p>
      <div class="flex gap-4">
        <a
          href="/tr/blog/"
          class="px-6 py-3 bg-slate-700 text-white rounded-lg hover:bg-slate-800 transition-colors"
        >
          Blog'a Git
        </a>
        <a
          href="/tr/about/"
          class="px-6 py-3 border border-gray-300 rounded-lg hover:bg-gray-100 transition-colors"
        >
          Hakkımda
        </a>
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold mb-8">Son Yazılar</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post) => {
          if (post.type === 'local') {
            return (
              <PostCard 
                post={{
                  title: post.title,
                  pubDate: post.pubDate,
                  description: post.description,
                  tags: post.tags,
                  author: post.author,
                  lang: post.lang,
                }} 
                slug={post.slug} 
                lang="tr" 
              />
            );
          } else {
            return (
              <MediumPostCard post={post} lang="tr" />
            );
          }
        })}
      </div>
      {totalPosts > 6 && (
        <div class="text-center mt-8">
          <a
            href="/tr/blog/"
            class="inline-block px-6 py-3 bg-slate-700 text-white rounded-lg hover:bg-slate-800 transition-colors"
          >
            Tüm Yazıları Gör
          </a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

