---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';
import SearchBox from '@components/SearchBox.astro';
import { t } from '../../lib/i18n';

const q = Astro.url.searchParams.get('q') || '';
---

<BaseLayout
  title={`${t('tr', 'search')} - Ertugrul Kara`}
  description="Ertugrul Kara yazı özetlerinde arama."
  lang="tr"
  currentPath="/tr/search"
>
  <PageShell lang="tr" currentPath="/tr/search" maxWidth="3xl">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-3 text-gray-800 dark:text-slate-100">{t('tr', 'search')}</h1>
      <p class="text-gray-600 dark:text-slate-300">{t('tr', 'searchLead')}</p>
    </header>
    <SearchBox lang="tr" />
    {q && <p class="sr-only">Sorgu: {q}</p>}
  </PageShell>
</BaseLayout>
