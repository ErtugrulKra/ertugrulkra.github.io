---
import BaseLayout from '@layouts/BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import Footer from '@components/Footer.astro';

const experience = [
  {
    title: 'Senior Software Architect',
    company: 'Odeon Yazılım ve Teknoloji',
    location: 'Turkiye',
    responsibilities: [
     
    ],
  },
  {
    title: 'Software Consultant | Team Manager',
    company: 'e-Logo (Logo Yazılım A.Ş.)',
    location: 'Turkiye',
    responsibilities: [
      'Designed and implemented a scalable Microservice Framework for e-Invoice compliance.',
      'Managed and mentored a 12-person engineering team, driving Agile/Scrum transformation.',
      'Developed distributed systems for large-scale document storage and processing.',
      'Led DevOps integration, optimizing CI/CD pipelines and system automation.',
    ],
  },
  {
    title: 'Software Team Manager',
    company: 'Foriba (Sovos)',
    location: 'Turkiye',
    responsibilities: [
      'Directed multiple cloud-based e-Invoice and e-Signature projects for international and domestic clients.',
      'Led Agile project teams ensuring on-time delivery and regulatory compliance.',
      'Designed ING Bank INGeF e-Invoice Cloud Platform and Türkiye Noterler Birliği e-Invoice System.',
      'Built and maintained high-volume B2B cloud applications for enterprise clients.',
    ],
  },
  {
    title: 'Senior Software Developer',
    company: 'Koyuncu Elektronik',
    location: 'Turkiye',
    responsibilities: [
      'Developed payment integration systems and SAP-integrated B2B applications.',
      'Created a MongoDB-powered distributed data system for transaction processing.',
    ],
  },
  {
    title: 'Software Developer',
    company: 'Insoft - Ergin Elektrik A.Ş',
    location: 'Turkiye',
    responsibilities: [
      'Developed ERP support applications integrating Java EE and Oracle-based databases.',
      'Built energy monitoring and reporting systems for industrial clients.',
    ],
  },
  {
    title: 'Software Developer',
    company: 'Kalem Yazılım',
    location: 'Turkiye',
    responsibilities: [
      'Designed production planning applications for Casper Computer Systems.',
      'Integrated Logo Go & Unity ERP systems into client operations.',
    ],
  },
];

const education = [
  {
    degree: 'B.Sc. Computer Engineering',
    institution: 'Üsküdar University',
    location: 'Turkiye',
  },
  {
    degree: 'B.Sc. Management Information Systems',
    institution: 'Istanbul University',
    location: 'Turkiye',
  },
  {
    degree: 'Associate Degree in Computer Technology & Programming',
    institution: 'Istanbul University',
    location: 'Turkiye',
  },
];

const certifications = [
  'Advanced Python Programming (BT Akademi, Istanbul)',
  'Aspect-Oriented Programming (Bilge Adam, Istanbul)',
  'Microsoft Application Developer (Netron, Istanbul)',
  'Docker & Kubernetes (Fikrimuhal, Istanbul)',
  'Microsoft Certified Professional (Microsoft)',
  'Inspire as a Leader (Baltaş, Istanbul)',
];
---

<BaseLayout
  title="About - Ertugrul Kara"
  description="About Ertugrul Kara, software developer"
  lang="en"
  currentPath="/about"
>
  <div class="flex">
    <!-- Sidebar -->
    <Sidebar currentPath="/about" lang="en" />

    <!-- Main Content -->
    <main class="flex-1 lg:ml-80 bg-white min-h-screen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 lg:py-8">
    <header class="mb-8">
      <h1 class="text-5xl font-bold mb-3 text-gray-800">About Me</h1>
      <p class="text-xl text-gray-600">
        Software engineer and team manager passionate about microservices, cloud computing, and building enterprise solutions that make a difference.
      </p>
    </header>

    <section class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-10 bg-blue-600"></div>
            <h2 class="text-3xl font-bold text-gray-800">Professional Summary</h2>
          </div>
      <p class="text-gray-700 mb-4 leading-relaxed">
        A software architect who enjoys designing scalable software systems and working with engineering teams. 
        Passionate about cloud-based e-Invoice and e-Signature systems, distributed applications, and microservice frameworks.
      </p>
      <p class="text-gray-700 leading-relaxed">
        Enthusiastic about learning modern technologies, improving development processes, and connecting technical solutions with business goals. 
        Experienced in Agile team management, DevOps practices, and delivering software solutions for different industries.
      </p>
    </section>

    <section class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-10 bg-blue-600"></div>
            <h2 class="text-3xl font-bold text-gray-800">Contact</h2>
          </div>
      <div class="space-y-2">
        <p>
          <strong>Email:</strong>{' '}
          <a href="mailto:hello@ertugrulkara.com" class="hover:underline text-blue-600 hover:text-blue-700 transition-colors">
            hello@ertugrulkara.com
          </a>
        </p>
        <p>
          <strong>GitHub:</strong>{' '}
          <a href="https://github.com/ertugrulkra" target="_blank" rel="noopener noreferrer" class="hover:underline text-blue-600 hover:text-blue-700 transition-colors">
            github.com/ertugrulkra
          </a>
        </p>
        <p>
          <strong>LinkedIn:</strong>{' '}
          <a href="https://www.linkedin.com/in/ertugrul-kra/" target="_blank" rel="noopener noreferrer" class="hover:underline text-blue-600 hover:text-blue-700 transition-colors">
            linkedin.com/in/ertugrul-kra
          </a>
        </p>
      </div>
    </section>

    <section class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-10 bg-blue-600"></div>
            <h2 class="text-3xl font-bold text-gray-800">Experience</h2>
          </div>
      <div class="space-y-6">
        {experience.map((exp) => (
          <div class="border-l-4 border-blue-500 pl-6 bg-gray-50 p-4 rounded-r-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-lg text-gray-800">{exp.title}</h3>
            <p class="text-gray-600 font-medium">{exp.company} • {exp.location}</p>
            <ul class="list-disc list-inside space-y-1 text-gray-700 mt-3">
              {exp.responsibilities.map((resp) => (
                <li>{resp}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-10 bg-blue-600"></div>
            <h2 class="text-3xl font-bold text-gray-800">Education</h2>
          </div>
      <div class="space-y-3">
        {education.map((edu) => (
          <div class="bg-gray-50 p-4 rounded-lg border-2 border-gray-200 hover:border-blue-500 transition-colors shadow-sm">
            <h3 class="font-bold text-gray-800">{edu.degree}</h3>
            <p class="text-gray-600">{edu.institution} • {edu.location}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-10 bg-blue-600"></div>
            <h2 class="text-3xl font-bold text-gray-800">Certifications</h2>
          </div>
      <div class="grid md:grid-cols-3 gap-3">
        {certifications.map((cert) => (
          <div class="bg-gray-50 p-3 rounded-lg text-sm text-gray-700 border-2 border-gray-200 hover:border-blue-500 transition-colors shadow-sm">
            {cert}
          </div>
        ))}
      </div>
    </section>

    <section>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-10 bg-blue-600"></div>
            <h2 class="text-3xl font-bold text-gray-800">Languages</h2>
          </div>
      <div class="space-y-2">
        <div class="flex justify-between items-center bg-gray-50 p-3 rounded-lg border-2 border-gray-200 hover:border-blue-500 transition-colors shadow-sm">
          <span class="font-medium text-gray-800">Turkish</span>
          <span class="text-sm text-gray-600">Native</span>
        </div>
        <div class="flex justify-between items-center bg-gray-50 p-3 rounded-lg border-2 border-gray-200 hover:border-blue-500 transition-colors shadow-sm">
          <span class="font-medium text-gray-800">English</span>
          <span class="text-sm text-gray-600">B2 Proficiency</span>
        </div>
      </div>
    </section>
      </div>
      <Footer />
    </main>
  </div>
</BaseLayout>
