---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';
import SearchBox from '@components/SearchBox.astro';
import { t } from '../lib/i18n';

const q = Astro.url.searchParams.get('q') || '';
---

<BaseLayout
  title={`${t('en', 'search')} - Ertugrul Kara`}
  description="Search technical article summaries by Ertugrul Kara."
  lang="en"
  currentPath="/search"
>
  <PageShell lang="en" currentPath="/search" maxWidth="3xl">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-3 text-gray-800 dark:text-slate-100">{t('en', 'search')}</h1>
      <p class="text-gray-600 dark:text-slate-300">{t('en', 'searchLead')}</p>
    </header>
    <SearchBox lang="en" />
    {q && <p class="sr-only">Query: {q}</p>}
  </PageShell>
</BaseLayout>
