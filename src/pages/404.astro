---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageShell from '@components/PageShell.astro';
import { t } from '../lib/i18n';
---

<BaseLayout
  title={`${t('en', 'notFoundTitle')} - Ertugrul Kara`}
  description={t('en', 'notFoundBody')}
  lang="en"
  currentPath="/404"
  noindex={true}
  hasLanguageAlternate={false}
>
  <PageShell lang="en" currentPath="/404" maxWidth="3xl">
    <div class="py-16 text-center">
      <p class="text-6xl font-bold text-blue-600 mb-4">404</p>
      <h1 class="text-3xl font-bold mb-3 text-gray-800 dark:text-slate-100">{t('en', 'notFoundTitle')}</h1>
      <p class="text-gray-600 dark:text-slate-300 mb-8">{t('en', 'notFoundBody')}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="px-5 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700">{t('en', 'backHome')}</a>
        <a href="/blog" class="px-5 py-2 rounded-lg border border-gray-300 dark:border-slate-600">{t('en', 'blog')}</a>
        <a href="/tr" class="px-5 py-2 rounded-lg border border-gray-300 dark:border-slate-600">{t('tr', 'backHome')}</a>
      </div>
    </div>
  </PageShell>
</BaseLayout>
