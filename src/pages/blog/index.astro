---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import MediumPostCard from '@components/MediumPostCard.astro';
import Sidebar from '@components/Sidebar.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';

// Get regular posts
const posts = await getCollection('en-posts', ({ data }) => {
  return data.lang === 'en';
});

// Try to load Medium posts
let mediumPosts = [];
try {
  const mediumPostsPath = path.join(process.cwd(), 'src/content/_medium/posts.json');
  if (fs.existsSync(mediumPostsPath)) {
    const fileContent = fs.readFileSync(mediumPostsPath, 'utf-8');
    mediumPosts = JSON.parse(fileContent);
  }
} catch (e) {
  console.error('Error loading Medium posts:', e);
}

// Combine all posts
const allPosts = [
  ...posts.map(p => ({
    type: 'local',
    slug: p.slug,
    title: p.data.title,
    description: p.data.description || '',
    pubDate: p.data.pubDate,
    tags: p.data.tags || [],
    author: p.data.author || 'Ertugrul Kara',
    lang: 'en',
  })),
  ...mediumPosts.map((m: any) => ({
    type: 'medium',
    title: m.title,
    link: m.link,
    pubDate: new Date(m.pubDate),
    contentSnippet: m.contentSnippet,
    categories: m.categories,
    guid: m.guid,
    author: m.author,
    lang: 'en',
  })),
];

// Sort by date
const sortedPosts = allPosts.sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());
---

<BaseLayout
  title="Blog - Ertugrul Kara"
  description="Blog posts and articles by Ertugrul Kara"
  lang="en"
  currentPath="/blog"
>
  <div class="flex">
    <!-- Sidebar -->
    <Sidebar currentPath="/blog" lang="en" />

    <!-- Main Content -->
    <main class="flex-1 lg:ml-80 bg-white min-h-screen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 lg:py-8">
        <header class="mb-8">
          <h1 class="text-5xl font-bold mb-3 text-gray-800">Blog</h1>
          <p class="text-xl text-gray-600">
            Thoughts on software development, technology, and more
          </p>
        </header>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {sortedPosts.map((post) => {
            if (post.type === 'local') {
              return (
                <PostCard 
                  post={{
                    title: post.title,
                    pubDate: post.pubDate,
                    description: post.description,
                    tags: post.tags,
                    author: post.author,
                    lang: post.lang,
                  }} 
                  slug={post.slug} 
                  lang="en" 
                />
              );
            } else {
              return (
                <MediumPostCard post={post} lang="en" />
              );
            }
          })}
        </div>

        {sortedPosts.length === 0 && (
          <p class="text-center text-gray-500 mt-12">
            No posts yet. Check back soon!
          </p>
        )}
      </div>
      <Footer />
    </main>
  </div>
</BaseLayout>
