# Optional public env vars. Copy to .env to enable these features.

# Giscus comments (local posts only). Create a Discussions category first.
# PUBLIC_GISCUS_REPO=owner/repo
# PUBLIC_GISCUS_REPO_ID=
# PUBLIC_GISCUS_CATEGORY=Announcements
# PUBLIC_GISCUS_CATEGORY_ID=

# Privacy-friendly analytics. Umami is hardcoded in src/components/Analytics.astro
# (website ID is public in the page source anyway). Optional Plausible:
# PUBLIC_PLAUSIBLE_DOMAIN=blog.ertugrulkara.com

# Twitter/X handle for card attribution, including the @.
# PUBLIC_TWITTER_HANDLE=@rtugrulkra
